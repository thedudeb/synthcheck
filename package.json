{
  "name": "synthcheck",
  "version": "0.1.0",
  "private": true,
  "description": "Private, browser-local AI image detection for Chrome",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "dev": "node scripts/build.mjs --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:chrome": "npm run build && node scripts/chrome-smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "benchmark:model": "tsx benchmark/download-model.ts",
    "benchmark:prepare": "tsx benchmark/prepare-defactify.ts",
    "benchmark:run": "tsx benchmark/run.ts",
    "benchmark:frontier:prepare": "tsx benchmark/prepare-frontier-audit.ts",
    "benchmark:frontier:transform": "tsx benchmark/transform-frontier-audit.ts",
    "benchmark:frontier:summarize": "tsx benchmark/summarize-frontier-audit.ts",
    "benchmark:modern:prepare": "tsx benchmark/modern/prepare.ts",
    "benchmark:modern:prepare:docci": "benchmark/.venv/bin/python benchmark/modern/prepare_docci.py",
    "benchmark:modern:calibrate": "tsx benchmark/modern/fit_browser_calibration.ts",
    "benchmark:modern:summarize": "tsx benchmark/summarize-modern-evaluation.ts"
  },
  "dependencies": {
    "onnxruntime-web": "1.22.0"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/chrome": "0.0.326",
    "@types/node": "22.17.0",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "esbuild": "0.25.8",
    "eslint": "9.32.0",
    "playwright-core": "1.54.2",
    "sharp": "0.35.3",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.0",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20.9"
  }
}

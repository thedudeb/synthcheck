{
  "name": "synthcheck",
  "version": "0.1.0",
  "private": true,
  "description": "Private, browser-local AI image detection for Chrome",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "dev": "node scripts/build.mjs --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:chrome": "npm run build && node scripts/chrome-smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "onnxruntime-web": "1.22.0"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/chrome": "0.0.326",
    "@types/node": "22.17.0",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "esbuild": "0.25.8",
    "eslint": "9.32.0",
    "playwright-core": "1.54.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.0",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=18.18"
  }
}
